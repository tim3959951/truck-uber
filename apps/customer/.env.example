# Copy to .env (never commit .env). Values are public (anon key) but keep .env out of git anyway.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# supabase | mock   (mock = offline demo, no network)
EXPO_PUBLIC_BACKEND=supabase
# optional overrides
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
