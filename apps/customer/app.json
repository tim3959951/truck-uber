{
  "expo": {
    "name": "Pallo",
    "slug": "truck-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tw.truckgo.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用來設定裝貨地點",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tw.truckgo.customer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Pallo",
      "shortName": "Pallo",
      "lang": "zh-Hant",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff",
      "display": "standalone"
    },
    "scheme": "truckcustomer",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pallo 需要您的位置來設定裝貨地點"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pallo 需要相機拍攝現場貨物照片，作為司機接單參考與出貨證明。",
          "photosPermission": "Pallo 需要讀取相簿以選擇現場貨物照片。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
